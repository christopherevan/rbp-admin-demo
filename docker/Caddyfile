{
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp
}

# SERVER_NAME is a domain (automatic HTTPS) or ":80" behind a reverse proxy.
{$SERVER_NAME::80} {
	root * /app/public
	encode zstd br gzip

	# Uploads are file names only, so nothing legitimate is large.
	request_body {
		max_size 2MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}

	# Only the landing and about pages are for search engines.
	@private not path / /about /build/* /favicon.svg /robots.txt
	header @private X-Robots-Tag "noindex, nofollow"

	@assets path /build/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Classic mode only, never `worker`: each visitor's sandbox is selected by
	# switching the default DB connection per request, which is only safe
	# when every request boots fresh.
	php_server
}
