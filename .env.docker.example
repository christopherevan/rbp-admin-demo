APP_NAME="Kinetra Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.com
APP_TIMEZONE=Asia/Jakarta

# A domain gets automatic HTTPS from FrankenPHP (ports 80 and 443 must reach
# the container). Behind your own reverse proxy, use ":80" and set
# HTTP_BIND=127.0.0.1:8080 so only the proxy can reach it.
SERVER_NAME=demo.example.com
HTTP_BIND=80
HTTPS_BIND=443

# Only behind a reverse proxy: its address, so client IPs (and rate limits)
# come from X-Forwarded-For. Leave empty when exposed directly.
TRUSTED_PROXIES=

DB_CONNECTION=sandbox
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DEMO_SANDBOX_ENABLED=true
DEMO_SOURCE_URL=
DEMO_PORTFOLIO_URL=

# Optional Cloudflare Turnstile keys for the demo entry page.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set automatically by CD when pulling pre-built images from GHCR.
# Leave commented out to build locally with `docker compose up -d --build`.
# APP_IMAGE=ghcr.io/<owner>/<repo>:latest
